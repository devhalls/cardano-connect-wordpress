{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cardano-connect/pools",
  "version": "0.1.0",
  "title": "Cardano Pool List",
  "category": "widgets",
  "description": "Cardano pool listing, provides view for pools and their metadata. Optionally filterable by pool ID(s).",
  "keywords": [
    "Cardano",
    "wallet",
    "connect",
    "SPOs"
  ],
  "example": {},
  "supports": {
    "html": false
  },
  "textdomain": "cardano-connect",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./../../shared/render.php",
  "attributes": {
    "whitelist": {
      "type": "string"
    },
    "per_page": {
      "type": "number",
      "default": 10
    },
    "not_found": {
      "type": "string"
    },
    "view": {
      "type": "string",
      "default": "grid"
    },
    "gated": {
      "type": "string"
    },
    "gated_placeholder": {
      "type": "string"
    },
    "gate": {
      "type": "string",
      "default": "none"
    },
    "gate_hide_component": {
      "type": "boolean",
      "default": false
    }
  }
}