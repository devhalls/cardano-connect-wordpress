{
	"name": "cardano-connect-blocks",
	"version": "0.1.0",
	"description": "Cardano connect blocks",
	"author": "PendulumDev",
	"license": "GPL-2.0-or-later",
	"homepage": "https://pendulumdev.co.uk",
	"main": "build/index.js",
	"scripts": {
		"start-connector": "wp-scripts start --webpack-copy-php --webpack-src-dir=connector/src/ --output-path=connector/build/",
		"start-assets": "wp-scripts start --webpack-copy-php --webpack-src-dir=assets/src/ --output-path=assets/build/",
		"start-balance": "wp-scripts start --webpack-copy-php --webpack-src-dir=balance/src/ --output-path=balance/build/",
		"start-pools": "wp-scripts start --webpack-copy-php --webpack-src-dir=pools/src/ --output-path=pools/build/",
		"start-dreps": "wp-scripts start --webpack-copy-php --webpack-src-dir=dreps/src/ --output-path=dreps/build/",
		"build-connector": "wp-scripts build --webpack-copy-php --webpack-src-dir=connector/src/ --output-path=connector/build/",
		"build-assets": "wp-scripts build --webpack-copy-php --webpack-src-dir=assets/src/ --output-path=assets/build/",
		"build-balance": "wp-scripts build --webpack-copy-php --webpack-src-dir=balance/src/ --output-path=balance/build/",
		"build-pools": "wp-scripts build --webpack-copy-php --webpack-src-dir=pools/src/ --output-path=pools/build/",
		"build-dreps": "wp-scripts build --webpack-copy-php --webpack-src-dir=dreps/src/ --output-path=dreps/build/",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"update": "wp-scripts packages-update"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^14.21.0",
		"@wordpress/scripts": "^28.6.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.48.0",
		"@wordpress/blocks": "^13.10.0",
		"@wordpress/components": "^28.13.0",
		"@wordpress/data": "^10.48.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/i18n": "^5.26.0"
	}
}
